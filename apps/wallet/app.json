{
  "expo": {
    "name": "ned-finance-wallet",
    "slug": "ned-finance-wallet",
    "version": "1.0.0",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ],
      "expo-localization",
      "expo-secure-store",
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ffd909b9-8b21-4311-b6b6-f795be84def1"
      }
    },
    "android": {
      "package": "finance.ned.wallet"
    },
    "ios": {
      "bundleIdentifier": "finance.ned.wallet"
    }
  }
}
